{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USB Airlock scan result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "scan_id",
    "completed",
    "clean",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "scan_id": {
      "type": "string",
      "minLength": 1
    },
    "completed": {
      "type": "boolean"
    },
    "clean": {
      "type": "boolean"
    },
    "findings": {
      "type": "integer",
      "minimum": 0
    }
  }
}
